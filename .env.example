NODE_ENV=development
PORT=3000
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
APP_ORIGIN=http://localhost:3000
# Production requires HTTPS and Secure cookies. Trust only a local reverse proxy if needed.
TRUST_PROXY=none

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hopedb
PGUSER=your_postgres_user
PGPASSWORD=replace_with_your_local_password
# Supported values: disable (local PostgreSQL), verify-full (trusted TLS certificate).
PGSSLMODE=disable
